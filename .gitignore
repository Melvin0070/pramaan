.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Secrets — the audit log redacts, but nothing should get this far
.env
.env.*
*.pem
*.key

# Target repos are cloned, never vendored
targets/
!targets/.gitkeep

# Scanner output and working state
data/raw/
data/worktrees/
# Raw live-run output carries real file:line finding_ids -- D17 says no
# file:line for unfixed findings goes public, and git history is forever
# even after a later delete. Aggregated/redacted results are what's committed.
data/live/
*.sqlite
*.sqlite-journal
.coverage
.coverage.*
.DS_Store
